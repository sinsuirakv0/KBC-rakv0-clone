#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

entry_path="${BASH_SOURCE[0]}"
while [[ -L "${entry_path}" ]]; do
  entry_directory="$(cd -- "$(dirname -- "${entry_path}")" && pwd)"
  entry_path="$(readlink "${entry_path}")"
  if [[ "${entry_path}" != /* ]]; then
    entry_path="${entry_directory}/${entry_path}"
  fi
done

readonly KBC_CLONE_ROOT="$(cd -- "$(dirname -- "${entry_path}")/.." && pwd)"
export KBC_CLONE_ROOT

# 読込順は依存関係を表す。
source "${KBC_CLONE_ROOT}/lib/core.sh"
source "${KBC_CLONE_ROOT}/lib/registry.sh"
source "${KBC_CLONE_ROOT}/lib/android.sh"
source "${KBC_CLONE_ROOT}/lib/builder.sh"
source "${KBC_CLONE_ROOT}/lib/updater.sh"
source "${KBC_CLONE_ROOT}/lib/commands.sh"
source "${KBC_CLONE_ROOT}/lib/ui.sh"

kbc_main() {
  kbc_initialize_directories
  kbc_registry_initialize
  trap kbc_cleanup EXIT

  local command_name="${1:-menu}"
  if (($# > 0)); then
    shift
  fi

  case "${command_name}" in
    menu) kbc_ui_main ;;
    list) kbc_command_list "$@" ;;
    create) kbc_command_create "$@" ;;
    update) kbc_command_update "$@" ;;
    register) kbc_command_register "$@" ;;
    manage) kbc_ui_manage_apps ;;
    doctor) kbc_command_doctor ;;
    self-update|upgrade) kbc_command_self_update "$@" ;;
    help|-h|--help) kbc_command_help ;;
    version|--version)
      printf 'KBC clone %s\n' "$(tr -d '\r\n' <"${KBC_CLONE_ROOT}/VERSION")"
      ;;
    *) kbc_die "不明なコマンドです: ${command_name}" ;;
  esac
}

kbc_main "$@"
